    "train": {
        "n_iter": 100000,
        "val_freq": 2e3,
        "save_checkpoint_freq": 6e3,
        "print_freq": 200,
        "optimizer": {
            "type": "adam",
            "lr": 1e-4
        },
        "ema_scheduler": {
            "step_start_ema": 5000,
            "update_ema_every": 1,
