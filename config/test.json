            "style_ref_mode": "" 
        },
        "val": {
            "name": "OCTA",
            "mode": "HR",
            "dataroot": "",
            "datatype": "img",
            "l_resolution": 16,
            "r_resolution": 256,
            "image_high": 800,
            "image_width": 288,
            "data_len": -1,
            "style_ref_mode": "paired"
        }
    },
    "model": {
        "which_model_G": "", 
